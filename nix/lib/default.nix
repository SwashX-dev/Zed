{ self, nixpkgs }:

let
  inherit (nixpkgs) lib;

  baseModules = [
    self.nixosModules.default
    {
      nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
      nixpkgs.overlays = [ self.overlays.default ];
      # Record the exact Zed source revision in every generation.
      system.configurationRevision = self.rev or self.dirtyRev or "unknown";
    }
  ];

  readState =
    stateFile: if builtins.pathExists stateFile then lib.importJSON stateFile else { };
in
{
  # Build a Zed system from extra NixOS modules.  This is what Zed's own
  # ISO and test configurations use.
  mkZedSystem =
    {
      modules ? [ ],
      specialArgs ? { },
      managedState ? { },
    }:
    nixpkgs.lib.nixosSystem {
      specialArgs = {
        zedFlake = self;
        zedManagedState = managedState;
      }
      // specialArgs;
      modules = baseModules ++ modules;
    };

  # Build the system for an installed machine.  `hostDir` is the directory
  # holding the machine's flake (normally /etc/zed).  It must contain:
  #
  #   hardware-configuration.nix  generated by nixos-generate-config
  #   host.nix                    owned by the user; Zed tools never write it
  #   managed/state.json          owned by zedd; edited only through the
  #                               transaction engine (zed CLI / GUI apps)
  #
  # state.json is plain data.  Zed tools never generate Nix code from user
  # input; nix/modules/managed.nix maps the validated data onto options.
  mkHost =
    {
      hostDir,
      extraModules ? [ ],
      # Overrides managed/state.json; used by tests to predict generations.
      managedState ? null,
    }:
    nixpkgs.lib.nixosSystem {
      specialArgs = {
        zedFlake = self;
        zedManagedState =
          if managedState != null then managedState else readState (hostDir + "/managed/state.json");
      };
      modules =
        baseModules
        ++ [
          (hostDir + "/hardware-configuration.nix")
          (hostDir + "/host.nix")
          {
            # Keep the pinned Zed source and package set on the machine, so
            # that zed and Blueprint can rebuild the system without network
            # access, and `nix shell nixpkgs#...` uses the same packages.
            system.extraDependencies = [ self.outPath ];
            nix.registry.nixpkgs.flake = nixpkgs;
            # Only the store path: revision metadata differs between a git
            # checkout and the same source used as a path input.
            nix.registry.zed.to = {
              type = "path";
              path = "${self.outPath}";
            };
            nix.nixPath = [ "nixpkgs=${nixpkgs}" ];
          }
        ]
        ++ extraModules;
    };
}
